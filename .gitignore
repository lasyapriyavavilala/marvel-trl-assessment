# .gitignore

# ==============================
# Environment & Secrets
# ==============================
.env
*.env
.env.local
venv/
env/
ENV/

# ==============================
# API Keys & Credentials
# ==============================
*_api_key*
*credentials*
*.pem
*.key

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================
# Jupyter Notebook
# ==============================
.ipynb_checkpoints
*.ipynb_checkpoints

# ==============================
# Data & Cache
# ==============================
data/raw/*.json
data/processed/*.json
*.csv
*.parquet
*.db
*.sqlite
*.sqlite3

# Redis dump
dump.rdb

# ==============================
# IDE
# ==============================
.vscode/
.idea/
*.swp
*.swo
*~

# ==============================
# OS
# ==============================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Logs
# ==============================
*.log
logs/